{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git merge *)",
      "Bash(git worktree *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git push -u origin ap/*)",
      "Bash(git push origin ap/*)",
      "Bash(git rebase --onto *)",
      "Bash(git rebase origin/*)",
      "Bash(git rebase ap/*)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git push --force-with-lease origin ap/*)",
      "Bash(git push --force-with-lease=ap/* origin ap/*)",
      "Bash(git push origin --delete ap/*)",
      "Bash(gh pr create --draft *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr ready *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Edit(./docs/autopilot/**)",
      "Write(./docs/autopilot/**)",
      "Edit(./results/autopilot/team/**)",
      "Write(./results/autopilot/team/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/autopilot/**)",
      "Read(~/.netrc)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.devcontainer/**)",
      "Edit(./.autopilot/**)",
      "Edit(./autopilot.toml)",
      "Edit(./docs/autopilot/SPEC.md)",
      "Edit(./docs/autopilot/NOTES-HUMAN.md)",
      "Edit(./results/autopilot/ledger.jsonl)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push * HEAD:main)",
      "Bash(git push --tags *)",
      "Bash(git push --mirror *)",
      "Bash(git tag *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git config user.*)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *)",
      "Bash(gh api *)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh issue lock *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Write(./results/autopilot/ledger.jsonl)",
      "Write(./docs/autopilot/SPEC.md)",
      "Write(./docs/autopilot/NOTES-HUMAN.md)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "model": "opus",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "api.anthropic.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "codeload.github.com"
      ]
    },
    "filesystem": {
      "allowWrite": ["~/.cache/uv"],
      "denyWrite": [
        "./.claude/settings.json",
        "./.claude/hooks",
        "./.devcontainer",
        "./.git/hooks",
        "./.autopilot"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.config/autopilot",
        "~/.netrc",
        "./.env"
      ]
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": true
  }
}
