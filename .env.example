# App
PORT=3000

# Postgres (rules, schemas, sources, people, alerts, audit log)
POSTGRES_USER=alerting
POSTGRES_PASSWORD=alerting
POSTGRES_DB=alerting
DATABASE_URL=postgres://alerting:alerting@postgres:5432/alerting

# Redis (queues, dedup state, config-change broadcast)
REDIS_URL=redis://redis:6379

# ntfy (mobile push). Default is the local container from docker-compose.
# For real phone notifications without self-hosting, use the public server
# with a random, hard-to-guess topic name per person:
#   NTFY_URL=https://ntfy.sh
NTFY_URL=http://ntfy:80

# Public base URL of the UI, used for "open alert" links in notifications (e.g. ntfy)
PUBLIC_URL=http://localhost:3000